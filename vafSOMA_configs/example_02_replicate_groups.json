{
  "_about": "Same data as example_01, with the three leaves of each tip declared as replicates of one branch meristem (replicate_groups): one latent state per variant and group. Settings reduced for a quick run (8 EM starts); use the defaults for real data.",
  "experiment": "example_02_replicate_groups",
  "outdir": "vafSOMA_output",
  "input": {
