    "tree": "example",
    "replicate_groups": "vafSOMA_inputs/examples/example_tree/replicate_groups.tsv"
  },
  "model": {
    "layer_specific_seq": false,
    "vaf_phasing": "unphased",
    "layer_proportions": {
